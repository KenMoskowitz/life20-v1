---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getSiteSettings, getNavigation } from '../lib/sanity';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, canonicalUrl, ogImage, jsonLd, noindex = false } = Astro.props as Props;

// Site-wide CMS content. Both calls fail soft to null (see src/lib/sanity.ts)
// until the Sanity project is wired up, so this never breaks the build.
const [siteSettings, navigation] = await Promise.all([getSiteSettings(), getNavigation()]);
void siteSettings;
void navigation;

const defaultOgImage = 'https://thelife20.com/assets/og-default.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage ?? defaultOgImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600&family=DM+Mono:wght@500&display=swap" rel="stylesheet" />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Analytics slot: GTM/GA4/Meta Pixel IDs not yet confirmed with Laura (see docs/master-plan.md Section 9). -->

  <script is:inline>
    // Motion gate. All hide-then-reveal CSS is scoped to html.dz-ready, so if
    // JS never runs the page renders fully visible instead of blank. Set here
    // in <head> so it applies before first paint (no flash of unhidden content).
    document.documentElement.classList.add('dz-ready');
  </script>
</head>
<body>
  <Nav currentPath={Astro.url.pathname} />
  <slot />
  <Footer />

  <script is:inline>
    // Single shared observer for every scroll-triggered effect on the site.
    (function () {
      var targets = document.querySelectorAll('.dz-reveal');
      function revealAll() {
        for (var i = 0; i < targets.length; i++) targets[i].classList.add('dz-in');
      }
      try {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) { revealAll(); return; }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('dz-in');
            observer.unobserve(entry.target); // fire once, don't re-animate on scroll up
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
        for (var i = 0; i < targets.length; i++) observer.observe(targets[i]);
      } catch (err) {
        revealAll(); // never let a scripting failure leave content hidden
      }
    })();

    // Failsafe for the load-time hero entrance: if its animation never advanced
    // (page opened in a background tab freezes the timeline), force the content
    // visible. On a normal visit the animation has long since finished and this
    // finds nothing to fix.
    setTimeout(function () {
      var els = document.querySelectorAll('.dz-enter');
      for (var i = 0; i < els.length; i++) {
        if (parseFloat(getComputedStyle(els[i]).opacity) < 0.99) els[i].classList.add('dz-shown');
      }
    }, 2500);
  </script>
</body>
</html>
