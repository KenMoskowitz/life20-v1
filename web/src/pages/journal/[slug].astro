---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournalPost, getJournalPosts } from '../../lib/sanity';
import { journalPosts as fallbackPosts } from '../../data/journalPosts';

export async function getStaticPaths() {
  const cmsPosts = await getJournalPosts() as any[] | null;
  const posts = cmsPosts && cmsPosts.length > 0 ? cmsPosts : fallbackPosts;
  return posts.map((post: any) => ({
    params: { slug: post.slug?.current ?? post.slug },
  }));
}

const { slug } = Astro.params;
const cmsPost = await getJournalPost(slug as string) as any | null;
const post = cmsPost ?? fallbackPosts.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect('/journal');
}

const body: string[] = post.body ?? [];
---
<BaseLayout
  title={post.metaTitle ?? `${post.title} | Life 2.0 Journal`}
  description={post.metaDescription ?? post.excerpt}
  canonicalUrl={`https://thelife20.com/journal/${slug}`}
>
  <article class="journal-post">
    <div class="page-hero" style="padding-left:0; padding-right:0;">
      <a class="btn-text" href="/journal">&larr; Back to the Journal</a>
    </div>
    <h1>{post.title}</h1>
    <div class="meta">By Laura Kelly &middot; {post.category} &middot; {post.readTime}</div>
    <div class="body">
      {body.map((para) => <p>{para}</p>)}
    </div>
    <div style="margin-top: 56px; display:flex; gap:24px; flex-wrap:wrap;">
      <a class="btn-primary" href="/the-9-skills">Explore the 9 Skills</a>
      <a class="btn-text" href="/assessment">Take the free assessment</a>
    </div>
  </article>
</BaseLayout>
