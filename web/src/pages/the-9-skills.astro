---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage } from '../lib/sanity';
import { skills, skillGroups } from '../data/skills';

const cms = await getPage('the-9-skills') as Record<string, any> | null;

const title = cms?.metaTitle ?? 'The 9 Skills of Fulfillment | Life 2.0';
const description = cms?.metaDescription ?? 'Fulfillment is a capability, not a destination. The 9 Skills of Fulfillment are the learnable capacities that shape how you create and experience your life.';

// Part 2 of the alignment brief, verbatim.
const capabilityLines = [
  'Connection can be strengthened.',
  'Regulation can be learned.',
  'Agency can increase.',
  'Meaning can be created.',
  'Mastery can be developed.',
  'Aliveness can be practiced.',
];

const faqs = [
  {
    q: 'Why do you call them skills?',
    a: "Because fulfillment isn't something you either have or don't have. Connection can be strengthened. Regulation can be learned. Agency can increase. Calling them skills is the honest description of how they actually work, and it's the reason this is hopeful rather than diagnostic.",
  },
  {
    q: 'Is this a real clinical assessment?',
    a: "No. It's a self-assessment built for reflection, not a diagnostic instrument. It gives you a starting point for thinking about your own life, and nothing more than that.",
  },
  {
    q: 'What happens after I get my results?',
    a: "You'll see where all nine skills currently stand, which one may deserve your attention first, three questions to sit with, and one small experiment to try this week. From there, some people keep going on their own and some book a Clarity Call with Laura.",
  },
  {
    q: 'Do I need to score high everywhere to be doing well?',
    a: 'No. These are not nine areas of life you need to perfect. Most people are already well developed in several, and the goal is almost never to fix everything at once.',
  },
  {
    q: 'How is this different from generic life coaching?',
    a: 'The framework synthesizes decades of research across human flourishing, psychological wellbeing, self-determination, relationships, health, meaning, financial security and positive psychology. It gives us a shared map to work from instead of starting every conversation from scratch.',
  },
  {
    q: 'Is my score private?',
    a: 'Yes. This is a self-assessment for your own reflection, not something shared or published.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/the-9-skills" jsonLd={faqJsonLd}>
  <div class="page-hero wrap">
    <div class="eyebrow dz-enter" style="--dz-enter-delay:0s">The Framework</div>
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">You learned the skills of achievement. Nobody taught you the skills of fulfillment.</h1>
    <p class="lede dz-enter" style="--dz-enter-delay:0.16s">Most high performers have the business side mapped. Revenue, systems, growth targets, all of it tracked with real rigor. The 9 Skills bring that same intentionality to the rest of your life.</p>
  </div>

  <!-- Part 2: the core philosophy -->
  <section class="capability-band dz-reveal">
    <div class="capability-inner">
      <h2>Fulfillment is a capability.</h2>
      <p class="capability-lede">Fulfillment isn't something you either have or don't have. There are skills that make us more capable of creating and experiencing a fulfilling life.</p>
      <ul class="capability-list">
        {capabilityLines.map((line) => <li>{line}</li>)}
      </ul>
      <p class="capability-close">That's why we call them skills.<br /><em>And skills can be learned.</em></p>
    </div>
  </section>

  <section class="section wrap dz-reveal">
    <h2>Nine skills, in three groups</h2>
    <p class="body-copy">These are not nine areas of life you need to perfect. They are nine capacities that influence how you create and experience your life. You may already be highly developed in several. Usually the goal is not to fix everything. It's to identify the skill that deserves your attention now.</p>
  </section>

  {skillGroups.map((group) => (
    <section class="section wrap">
      <div class="group-head dz-reveal">
        <div class="eyebrow">{group.title}</div>
        <p class="body-copy" style="margin-top:0;">{group.description}</p>
      </div>
      <div class="card-grid" style="margin-top: 32px;">
        {skills.filter((s) => s.group === group.id).map((s, i) => (
          <div class="card skill-card dz-reveal" style={`--dz-delay:${i * 0.12}s`}>
            <h3 class="skill-name">{s.name}</h3>
            <p class="body-copy">{s.definition}</p>
            <p class="skill-core-q">{s.coreQuestion}</p>
            {s.paths && (
              <>
                <p class="skill-paths-label">Meaning can be created through</p>
                <ul class="skill-paths">
                  {s.paths.map((path) => <li>{path}</li>)}
                </ul>
              </>
            )}
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="section-narrow dz-reveal">
    <div class="eyebrow">On the research</div>
    <p class="body-copy">The Life 2.0 framework synthesizes decades of research across human flourishing, psychological wellbeing, self-determination, relationships, health, meaning, financial security and positive psychology.</p>
    <p class="body-copy">These nine names are Life 2.0's own synthesis of that work. No single study identified this exact list, and we won't pretend otherwise. What the research consistently supports is that these capacities matter, and that they can be developed.</p>
  </section>

  <CtaBand
    heading="Ready to see where each skill currently stands?"
    body="Take the free assessment. Nine skills, one honest starting point, and one small experiment to try this week."
  />

  <section class="section wrap">
    <h2 class="dz-reveal">FAQs</h2>
    <div class="faq">
      {faqs.map((f, i) => (
        <div class="faq-item dz-reveal" style={`--dz-delay:${Math.min(i * 0.08, 0.4)}s`}>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
