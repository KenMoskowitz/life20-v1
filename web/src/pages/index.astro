---
import BaseLayout from '../layouts/BaseLayout.astro';
import NineSkillsGrid from '../components/NineSkillsGrid.astro';
import QuotePanel from '../components/QuotePanel.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage } from '../lib/sanity';

const cms = await getPage('home') as Record<string, any> | null;

const title = cms?.metaTitle ?? 'Life 2.0 | Build the Life That Feels As Good As It Looks';
const description = cms?.metaDescription ?? 'You learned the skills of achievement. Nobody taught you the skills of fulfillment. The 9 Skills of Fulfillment show you where to start. Take the free assessment.';

// Part 3 of the alignment brief: the achievement-to-fulfillment bridge.
const achievementLines = [
  'Build the business.',
  'Lead the team.',
  'Make the money.',
  'Solve the problems.',
  'Perform under pressure.',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Laura Kelly',
  url: 'https://thelife20.com',
  jobTitle: 'Founder, Life 2.0',
  worksFor: {
    '@type': 'Organization',
    name: 'Life 2.0 Ventures LLC',
    url: 'https://thelife20.com',
  },
  sameAs: [],
};
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://thelife20.com/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-grid">
      <div>
        <div class="eyebrow dz-enter" style="--dz-enter-delay:0s">Life 2.0 &nbsp;&middot;&nbsp; Laura Kelly</div>
        <h1 class="dz-enter" style="--dz-enter-delay:0.08s">Build the life that feels <em>as good</em> as it looks.</h1>
        <p class="hero-lede dz-enter" style="--dz-enter-delay:0.16s">
          {cms?.heroLede ?? 'You mapped the business. Nobody ever handed you a map for the rest of it. The 9 Skills help you see which part of your fulfillment may deserve the most attention right now, so you know where to start.'}
        </p>
        <div class="hero-actions dz-enter" style="--dz-enter-delay:0.24s">
          <a class="btn-primary" href="/assessment">Take the free assessment &rarr;</a>
          <a class="btn-text" href="/about">Meet Laura</a>
        </div>
        <div class="hero-trust dz-enter" style="--dz-enter-delay:0.32s"><div class="dash"></div> Research-informed. Founder-led. Nine learnable skills.</div>
      </div>
      <div style="position:relative;">
        <div class="hero-photo-frame dz-enter" style="--dz-enter-delay:0.12s">
          <img class="dz-kenburns" src="/assets/laura-hero.jpg" alt="Laura Kelly, founder of Life 2.0" />
        </div>
        <div class="hero-badge dz-enter" style="--dz-enter-delay:0.44s"><b>9</b><span>learnable skills that shape a fulfilling life</span></div>
      </div>
    </div>
  </section>

  <!-- The problem, then the insight (message hierarchy steps 2 and 3) -->
  <section class="bridge-band">
    <div class="bridge-inner">
      <p class="bridge-open dz-reveal">You learned the skills of achievement.</p>
      <ul class="bridge-list">
        {achievementLines.map((line, i) => (
          <li class="dz-reveal" style={`--dz-delay:${i * 0.08}s`}>{line}</li>
        ))}
      </ul>
      <p class="bridge-turn dz-reveal">But nobody ever taught you the skills of <em>fulfillment</em>.</p>
      <p class="bridge-close dz-reveal">Life 2.0 does.</p>
    </div>
  </section>

  <NineSkillsGrid />

  <!-- Part 4: reframe immediately after introducing the nine -->
  <section class="section-narrow dz-reveal" style="text-align:center;">
    <p class="body-copy" style="margin:0 auto;">These are not nine areas of life you need to perfect. They are nine capacities that influence how you create and experience your life. You may already be highly developed in several.</p>
    <p class="pull-statement" style="margin:24px auto 0;">Usually the goal is not to fix everything. It's to identify the skill that deserves your attention now.</p>
  </section>

  <section class="founder">
    <div class="founder-grid">
      <div class="founder-photo dz-reveal">
        <img class="dz-kenburns--rev" src="/assets/laura-teaching.jpg" alt="Laura Kelly" />
      </div>
      <div class="dz-reveal" style="--dz-delay:0.1s">
        <div class="eyebrow">Hey, it's Laura</div>
        <h2>The people who achieved the most weren't necessarily the people who felt the most fulfilled.</h2>
        <p class="lede">I had a front-row seat to achievement, and I started noticing something I couldn't unsee. My own life could look incredible on paper and still not always feel the way I expected it to from inside it. That raised the question that became Life 2.0.</p>
        <div class="sig">Laura</div>
      </div>
    </div>
  </section>

  <QuotePanel />

  <CtaBand
    eyebrow="Start Here"
    heading="See which skill deserves your attention right now."
    body="Nine skills. One honest starting point. Three questions to sit with, and one small experiment to try this week."
  />
</BaseLayout>
