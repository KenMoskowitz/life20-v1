---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/sanity';
import ProofQuotes from '../components/ProofQuotes.astro';

const cms = await getPage('private-advisory') as Record<string, any> | null;

const title = cms?.metaTitle ?? 'Private Advisory | Life 2.0';
const description = cms?.metaDescription ?? 'The same six-week Life 2.0 framework as Access Your Next Level, fully individualized for ambitious founders and high performers. Founding client investment: $3,000/month. Apply for Private Advisory.';

const applyError = Astro.url.searchParams.get('error');

const whatYouGet = [
  {
    title: 'The Same Six-Week Framework, Fully Individualized',
    body: [
      "The full Life 2.0 curriculum, Pattern Recognition through Integration, built entirely around your life.",
      "We set the pace and depth by what's going on for you, session to session.",
    ],
  },
  {
    title: 'Six Private Sessions With Laura',
    body: [
      "One private session for each week of the curriculum, where we apply that week's work directly to your business and your life.",
      "We work on the problem in front of you and the life you're building at the same time.",
    ],
  },
  {
    title: 'Direct Access Between Sessions',
    body: [
      "Life doesn't conveniently happen once a week.",
      "Text or voice note Laura between sessions for questions, decisions, breakthroughs, and the moments you need another brain in the room.",
      "You never have to hold it all until the next call.",
    ],
  },
  {
    title: 'Your Final Digital Life 2.0 Integration Board',
    body: [
      "A personal board that captures your patterns, your primary question, and your direction, built to keep using long after the six weeks end.",
    ],
  },
  {
    title: 'Access to the Broader Life 2.0 Ecosystem',
    body: [
      "Relevant Life 2.0 frameworks, resources, and the wider Life 2.0 community, included.",
    ],
  },
];

const rhetoricalQuestions = [
  'Is this the life I want?',
  'What would make it extraordinary?',
  "What am I tolerating that I don't want to tolerate anymore?",
  'What would I change if I stopped assuming life had to work this way?',
];
const compareRows = [
  { label: 'Format', group: 'Small group, live', private: 'One to one with Laura' },
  { label: 'Sessions', group: '6 live group coaching calls', private: '6 private sessions' },
  { label: 'Between sessions', group: 'The Life 2.0 Room community', private: 'Direct text and voice access to Laura' },
  { label: 'Pace', group: 'Set by the cohort', private: 'Set by you' },
  { label: 'Integration Board', group: 'Included', private: 'Included' },
  { label: 'Founding investment', group: '$1,500', private: '$3,000/month' },
];

const howItWorks = [
  { title: 'Apply', body: 'Answer a few short questions about you and what’s going on. It takes about two minutes.' },
  { title: 'Book your call', body: 'Pick a time for your Clarity Call straight away. No waiting to hear back.' },
  { title: 'Laura prepares', body: 'Laura reads your answers herself before you talk, so the call goes straight to what matters.' },
  { title: 'Begin', body: 'If it’s the right fit for you both, your six weeks start, built around your life from the first session.' },
];

// Application questions. The answers arrive in Laura's lead alert email and
// are saved in Sanity under Applications.
const businessSizes = ['Under $1M a year', '$1M to $5M', '$5M to $20M', '$20M+', 'I lead someone else’s business'];
const focusAreas = [
  'Purpose & Meaning', 'Relationships', 'Identity & Autonomy',
  'Growth & Challenge', 'Physical Vitality', 'Financial Security',
  'Contribution', 'Presence & Aliveness', 'Character & Virtue', 'Not sure yet',
];
const investOptions = ['Yes', 'Possibly, I’d like to talk it through', 'Not right now'];
const sources = ['Facebook or Instagram', 'LinkedIn', 'A free training or webinar', 'A friend or colleague', 'Clover', 'Google', 'Other'];

const faqs = [
  {
    q: 'Why is there an application?',
    a: 'Private Advisory is capacity-limited during the founding chapter, and it works best when it’s the right fit. A few short answers mean Laura arrives at your Clarity Call already knowing what matters to you, so neither of you wastes a minute.',
  },
  {
    q: 'How is this different from Access Your Next Level?',
    a: 'Same six-week framework. Private Advisory is one to one, paced around your life, with Laura on hand between sessions. If you’d rather start in a small group, Access Your Next Level is the place.',
  },
  {
    q: 'Is this therapy?',
    a: 'No. This is coaching for capable people designing what comes next. If you’re looking for treatment for a mental-health condition, a licensed professional is the right place to begin.',
  },
  {
    q: 'What does the founding rate mean?',
    a: 'Founding clients come in at $3,000 a month, and that rate is locked in for as long as you stay continuously active in Private Advisory.',
  },
];
---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/private-advisory">
  <div class="page-hero wrap">
    <div class="eyebrow dz-enter" style="--dz-enter-delay:0s">Private Advisory</div>
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">Build a life that feels as successful as it looks.</h1>
    <p class="lede dz-enter" style="--dz-enter-delay:0.16s">Six weeks, one to one with Laura Kelly. The full Life 2.0 framework built around your life, with Laura a text away between sessions.</p>
    <ul class="pa-hero-facts dz-enter" style="--dz-enter-delay:0.2s">
      <li>6 private sessions</li>
      <li>Direct access between calls</li>
      <li>Founding clients only</li>
    </ul>
    <div class="hero-actions dz-enter" style="--dz-enter-delay:0.24s; margin-top:32px;">
      <a class="btn-primary" href="#apply">Apply for Private Advisory &rarr;</a>
      <a class="btn-text" href="#pricing">See founding client pricing</a>
    </div>
  </div>

  <div class="founder-grid pa-founder-grid wrap" style="padding-bottom: 40px;">
    <div class="founder-photo dz-reveal">
      <img class="dz-kenburns" src="/assets/laura-advisory.jpg" alt="Laura Kelly, Private Advisory" />
    </div>
    <div class="dz-reveal" style="--dz-delay:0.1s">
      <h2>You know how to achieve.</h2>
      <p class="body-copy" style="margin-top:20px;">But achievement alone doesn't guarantee that your relationships feel incredible. That your home runs smoothly. That you have time to think. That your health, family, friendships, purpose, and day-to-day life feel the way you want them to.</p>
      <div class="emphasis-lines">
        <p>Life 2.0 is about designing the whole thing.</p>
        <p>Keeping the ambition.</p>
        <p>Building a life big enough to hold it.</p>
      </div>
      <h3 class="pa-founder-subhead">The Life 2.0 Private Advisory</h3>
      <p class="body-copy">Six focused weeks, built around exactly what's going on in your life right now.</p>
      <p class="body-copy">We work on what's in front of you while building toward where you want your life to go.</p>
      <p class="pull-statement">The goal is simple: a life you're wildly excited to wake up to.</p>
    </div>
  </div>

  <section class="section wb-section-tight wrap">
    <h2 class="dz-reveal">What you get</h2>
    <div class="numbered-features">
      {whatYouGet.map((item, i) => (
        <div class="numbered-feature dz-reveal" style={`--dz-delay:${Math.min(i * 0.06, 0.3)}s`}>
          <div class="num">{String(i + 1).padStart(2, '0')}</div>
          <div>
            <h3>{item.title}</h3>
            {item.body.map((p) => <p class="body-copy">{p}</p>)}
            {item.subList && (
              <ul class="sub-list">
                {item.subList.map((s) => <li>{s}</li>)}
              </ul>
            )}
            {item.closing && <p class="body-copy" style="font-weight:600; color:var(--forest);">{item.closing}</p>}
          </div>
        </div>
      ))}
    </div>
    <a class="btn-text dz-reveal" href="/access-your-next-level#included" style="display:inline-block; margin-top:32px;">See the full six-week curriculum &rarr;</a>
  </section>

  <ProofQuotes />

  <section class="section wb-section-tight wrap dz-reveal">
    <div class="wb-for-split pa-who-split">
      <div class="wb-for-image">
        <img src="/assets/laura-bookshelf.jpg" alt="Laura Kelly" loading="lazy" />
      </div>
      <div class="pa-who-text">
        <h2>Who this is for</h2>
        <p class="body-copy">Private Advisory is for people who are ambitious, capable, and willing to do the work. The business, the career, the family, the life on paper may already be there. The questions are just getting bigger.</p>
        <ul class="rhetorical-list">
          {rhetoricalQuestions.map((q) => <li>{q}</li>)}
        </ul>
        <p class="pull-statement pa-who-closer">And most importantly: what do I want my Life 2.0 to be?</p>
      </div>
    </div>
  </section>

  <section class="section wb-section-tight wrap">
    <div class="pa-section-head dz-reveal">
      <h2>Private or group?</h2>
      <p class="body-copy">Both run on the same six-week framework. Here's how they differ.</p>
    </div>
    <div class="pa-compare dz-reveal">
      <div class="pa-compare-row pa-compare-head">
        <div></div>
        <div>Access Your Next Level</div>
        <div class="pa-compare-private">Private Advisory</div>
      </div>
      {compareRows.map((r) => (
        <div class="pa-compare-row">
          <div class="pa-compare-label">{r.label}</div>
          <div><span class="pa-compare-mobile">Group: </span>{r.group}</div>
          <div class="pa-compare-private"><span class="pa-compare-mobile">Private: </span>{r.private}</div>
        </div>
      ))}
      <div class="pa-compare-row pa-compare-foot">
        <div></div>
        <div><a class="btn-text" href="/access-your-next-level">See the group program &rarr;</a></div>
        <div class="pa-compare-private"><a class="btn-primary" href="#apply">Apply for Private Advisory &rarr;</a></div>
      </div>
    </div>
  </section>

  <section class="section wb-section-tight wrap pa-pricing-split" id="pricing">
    <div class="dz-reveal pa-pricing-intro pa-pricing-intro-boxed">
      <h2 class="pa-pricing-eyebrow">Founding client opportunity</h2>
      <p class="body-copy">Life 2.0 is in its founding chapter, and Laura is opening a small number of Private Advisory spots. Founding clients get the full private experience, and a real hand in shaping what Life 2.0 becomes.</p>
      <a class="btn-primary" href="#apply" style="margin-top:28px; align-self:center;">Apply for Private Advisory &rarr;</a>
    </div>

    <div class="pricing-card dz-reveal" style="--dz-delay:0.1s">
      <div class="eyebrow">Six-Week Private Advisory</div>
      <div class="price">$3,000<span>/month</span></div>
      <p>Your founding rate is locked in for as long as you stay continuously active in Private Advisory.</p>
      <p>The full experience, from the very beginning.</p>
    </div>
  </section>

  <section class="section wb-section-tight wrap">
    <div class="pa-section-head dz-reveal">
      <h2>How it works</h2>
    </div>
    <ol class="pa-steps">
      {howItWorks.map((step, i) => (
        <li class="dz-reveal" style={`--dz-delay:${i * 0.08}s`}>
          <span class="stage-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p class="body-copy">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wb-section-tight wrap">
    <div class="pa-section-head dz-reveal">
      <h2>Questions people ask</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <div class="faq-item dz-reveal">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- No dz-reveal here: this is an anchor target (#apply), it must be visible the instant it's jumped to. -->
  <section class="section wrap" id="apply">
    <div class="pa-apply-head">
      <h2>Apply for Private Advisory</h2>
      <p class="body-copy">Spots are limited during the founding chapter. Answer a few short questions, then book your Clarity Call straight away. Laura reads every answer herself before you talk.</p>
    </div>
    {applyError && (
      <p class="body-copy" style="color:#B5533C; font-weight:600; margin-top:20px;">
        {applyError === 'missing-fields' ? 'Please answer every question marked with a star before applying.' : 'Something went wrong submitting your application. Please try again in a moment.'}
      </p>
    )}
    <form class="form-panel pa-app" style="margin-top:32px;" action="/api/private-advisory-application" method="post">
      <div class="pa-app-row">
        <div class="form-field">
          <label for="name">Name *</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="email">Email *</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>
      <div class="form-field">
        <label for="phone">Phone <span class="pa-app-optional">(optional)</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="form-field">
        <label for="work">What do you do? *</label>
        <input id="work" name="work" type="text" placeholder="Your role and business" required />
      </div>
      <div class="form-field">
        <label for="businessSize">Roughly how big is your business? *</label>
        <select id="businessSize" name="businessSize" required>
          <option value="" disabled selected>Choose one</option>
          {businessSizes.map((o) => <option>{o}</option>)}
        </select>
      </div>
      <div class="form-field">
        <label for="focusArea">Which area of life feels most off right now? *</label>
        <select id="focusArea" name="focusArea" required>
          <option value="" disabled selected>Choose one</option>
          {focusAreas.map((o) => <option>{o}</option>)}
        </select>
      </div>
      <div class="form-field">
        <label for="context">What’s going on right now? *</label>
        <textarea id="context" name="context" rows="4" required></textarea>
      </div>
      <div class="form-field">
        <label for="win">What would make the next six months a real win? *</label>
        <textarea id="win" name="win" rows="3" required></textarea>
      </div>
      <fieldset class="form-field pa-app-invest">
        <legend>Private Advisory is $3,000 a month for founding clients. If it’s the right fit, are you ready to invest at that level? *</legend>
        {investOptions.map((o, i) => (
          <label class="pa-app-radio"><input type="radio" name="investReady" value={o} required={i === 0} /> {o}</label>
        ))}
      </fieldset>
      <div class="form-field">
        <label for="source">How did you hear about Laura? <span class="pa-app-optional">(optional)</span></label>
        <select id="source" name="source">
          <option value="" selected>Choose one</option>
          {sources.map((o) => <option>{o}</option>)}
        </select>
      </div>
      <button class="btn-primary" type="submit" style="width:100%; justify-content:center;">Apply and book my call &rarr;</button>
    </form>
  </section>
</BaseLayout>

<style>
  .pa-hero-facts { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .pa-hero-facts li { display: flex; align-items: center; gap: 10px; font: 600 15px/1.3 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--sage); }
  .pa-hero-facts li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

  .pa-section-head { max-width: 720px; margin: 0 auto; text-align: center; }
  .pa-section-head .body-copy { margin: 14px auto 0; }

  /* --- Private vs group comparison --- */
  .pa-compare { margin-top: 40px; background: var(--white); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; }
  .pa-compare-row { display: grid; grid-template-columns: 0.8fr 1fr 1fr; border-top: 1px solid var(--line); }
  .pa-compare-row:first-child { border-top: none; }
  .pa-compare-row > div { padding: 18px 24px; font: 400 18px/1.5 var(--sans); color: var(--ink); }
  .pa-compare-head > div { font: 600 15px/1.3 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--sage); }
  .pa-compare-label { font-weight: 600; color: var(--forest); }
  .pa-compare-private { background: var(--paper-warm); }
  .pa-compare-head .pa-compare-private { color: var(--gold); }
  .pa-compare-foot > div { display: flex; align-items: center; }
  .pa-compare-mobile { display: none; }
  @media (max-width: 760px) {
    .pa-compare-row { grid-template-columns: 1fr; }
    .pa-compare-row > div { padding: 10px 20px; }
    .pa-compare-head, .pa-compare-foot > div:first-child { display: none; }
    .pa-compare-label { padding-top: 18px !important; }
    .pa-compare-mobile { display: inline; font-weight: 600; color: var(--sage); }
  }

  /* --- How it works --- */
  .pa-steps { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .pa-steps li { background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 26px 24px; }
  .pa-steps h3 { margin-top: 12px; font: 500 21px/1.3 var(--serif); color: var(--forest); }
  .pa-steps .body-copy { margin-top: 8px; }
  @media (max-width: 980px) { .pa-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .pa-steps { grid-template-columns: 1fr; } }

  /* "You know how to achieve." had no font rule of its own anywhere in the
     site (only .section h2, .founder h2, etc. exist) — it was quietly
     rendering as a plain bold system heading instead of the branded serif
     used everywhere else. Style it here, and size both it and the "Life 2.0
     Private Advisory" copy folded in below it down to fit as supporting
     column text beside the photo, not a full page-width section heading. */
  .pa-founder-grid h2 { font: 500 clamp(26px, 2.6vw, 34px)/1.2 var(--serif); color: var(--forest); }
  .pa-founder-subhead { margin-top: 32px; margin-bottom: 12px; font: 500 clamp(21px, 2vw, 26px)/1.3 var(--serif); color: var(--forest); }
  .pa-founder-grid .pull-statement { font-size: 20px; max-width: none; }

  /* The rhetorical questions above it are already italic serif, so the
     closing line in that same style read as just one more item in the list
     instead of the punch line. Make it upright and bolder so it lands. */
  .pa-who-closer { font-style: normal; font-weight: 700; font-size: clamp(24px, 2.6vw, 32px); }

  /* One "Founding client opportunity" heading instead of it and the pricing
     card's own "Founding Client Investment" eyebrow both saying the same
     thing, side by side instead of stacked so the card doesn't sit under a
     full-width intro paragraph with nothing beside it. */
  .pa-pricing-split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; }
  .pa-pricing-split .pricing-card { margin-top: 0; }
  @media (max-width: 860px) { .pa-pricing-split { grid-template-columns: 1fr; gap: 32px; } }

  /* Match the "Founding client opportunity" heading to the eyebrow tag style
     used for "Private Advisory" at the top of the page (mono, uppercase,
     letter-spaced, gold), instead of the default big serif section heading. */
  .pa-pricing-eyebrow { display: flex; align-items: center; gap: 12px; font: 600 clamp(18px, 1.8vw, 22px)/1.3 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
  .pa-pricing-eyebrow::before { content: ""; width: 34px; height: 1px; background: var(--gold); flex-shrink: 0; }

  .pa-pricing-intro .body-copy { margin-top: 16px; }

  /* A bordered box matching the pricing card's shape and weight, instead of
     plain unboxed text that read as thin and small beside it. Bigger body
     text too, to hold its own next to the card's bold price and copy. */
  .pa-pricing-intro-boxed {
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(32px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pa-pricing-intro-boxed .body-copy { font-size: clamp(20px, 1.7vw, 24px); line-height: 1.7; }


  /* --- Application form: sentence-case question labels (the shared
     uppercase mono labels are unreadable at question length) --- */
  .pa-app { max-width: 640px; }
  .pa-app .form-field label, .pa-app legend { font: 600 18px/1.4 var(--sans); letter-spacing: 0; text-transform: none; color: var(--forest); }
  .pa-app-optional { font-weight: 400; color: var(--ink-soft); }
  .pa-app-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  .pa-app-row .form-field { min-width: 0; }
  .pa-app input, .pa-app select, .pa-app textarea { width: 100%; box-sizing: border-box; }
  .pa-app .pa-app-radio input { width: 18px; }
  @media (max-width: 560px) { .pa-app-row { grid-template-columns: 1fr; } }
  .pa-app select {
    font: 400 18px/1.5 var(--sans); color: var(--ink); background: var(--paper);
    border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px;
  }
  .pa-app select:focus { outline: 2px solid var(--gold); outline-offset: 1px; }
  .pa-app-invest { border: none; padding: 0; margin: 4px 0 20px; }
  .pa-app-invest legend { margin-bottom: 12px; }
  .pa-app .pa-app-radio { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); font: 400 18px/1.4 var(--sans); color: var(--ink); cursor: pointer; margin-bottom: 8px; }
  .pa-app-radio input { accent-color: var(--forest); width: 18px; height: 18px; }

  /* Center the apply heading + intro to match the centered form below it. */
  .pa-apply-head { max-width: 560px; margin: 0 auto; text-align: center; }
  .pa-apply-head .body-copy { margin-top: 16px; }

  /* The heading, paragraph, question list, and closing line had three
     different fixed gaps between them (20px, 18px, 32px), which read as
     lumpy rather than an even rhythm running the length of the photo.
     space-between looked like the fix, but this column's content is
     already about as tall as the photo, so there was no slack left for it
     to distribute — every gap just collapsed to 0. A single consistent
     gap gets the even rhythm without depending on leftover space. */
  .pa-who-text { display: flex; flex-direction: column; gap: 28px; }
  .pa-who-text .body-copy, .pa-who-text .rhetorical-list, .pa-who-text .pull-statement { margin-top: 0; }
</style>
