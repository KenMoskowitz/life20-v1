---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/sanity';

const cms = await getPage('private-advisory') as Record<string, any> | null;

const title = cms?.metaTitle ?? 'Private Advisory | Life 2.0';
const description = cms?.metaDescription ?? 'The same six-week Life 2.0 framework as Access Your Next Level, fully individualized for ambitious founders and high performers. Founding client investment: $2,000/month. Apply for Private Advisory.';

const applyError = Astro.url.searchParams.get('error');

const whatYouGet = [
  {
    title: 'The Same Six-Week Framework, Fully Individualized',
    body: [
      "Private Advisory runs on the identical curriculum, Pattern Recognition through Integration, built entirely around your life.",
      "The pace and depth are set by exactly what's going on for you, session to session.",
    ],
  },
  {
    title: 'Six Private Sessions With Laura',
    body: [
      "One private session for each week of the curriculum, where we apply that week's module directly to what's happening in your business and your life.",
      "Immediate problems and long-term transformation. You don't have to choose between the two.",
    ],
  },
  {
    title: 'Direct Access Between Sessions',
    body: [
      "Life doesn't conveniently happen once a week.",
      "You'll have high-touch access to Laura between sessions via text and voice note for questions, decisions, breakthroughs, and moments when you need another brain in the room.",
      "You don't have to hold everything until your next scheduled session.",
    ],
  },
  {
    title: 'Your Final Digital Life 2.0 Integration Board',
    body: [
      "The same personalized deliverable Access Your Next Level members leave with: a final board that captures your patterns, your primary question, and your direction, built to use after the six weeks end.",
    ],
  },
  {
    title: 'Access to the Broader Life 2.0 Ecosystem',
    body: [
      "You'll have access to relevant Life 2.0 frameworks, resources, and the wider Life 2.0 environment as part of your engagement.",
    ],
  },
];

const rhetoricalQuestions = [
  'Is this the life I want?',
  'What would make it extraordinary?',
  "What am I tolerating that I don't want to tolerate anymore?",
  'What would I change if I stopped assuming life had to work this way?',
];
---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/private-advisory">
  <div class="page-hero wrap">
    <div class="eyebrow dz-enter" style="--dz-enter-delay:0s">Private Advisory</div>
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">Build a life that feels as successful as it looks.</h1>
    <p class="lede dz-enter" style="--dz-enter-delay:0.16s">The same six-week Life 2.0 framework as Access Your Next Level, delivered privately and built entirely around your life, at a depth a group format can't match.</p>
    <div class="hero-actions dz-enter" style="--dz-enter-delay:0.24s; margin-top:32px;">
      <a class="btn-primary" href="#apply">Apply for Private Advisory &rarr;</a>
      <a class="btn-text" href="#pricing">See founding client pricing</a>
    </div>
  </div>

  <div class="founder-grid pa-founder-grid wrap" style="padding-bottom: 40px;">
    <div class="founder-photo dz-reveal">
      <img class="dz-kenburns" src="/assets/laura-advisory.jpg" alt="Laura Kelly, Private Advisory" />
    </div>
    <div class="dz-reveal" style="--dz-delay:0.1s">
      <h2>You know how to achieve.</h2>
      <p class="body-copy" style="margin-top:20px;">But achievement alone doesn't guarantee that your relationships feel incredible. That your home runs smoothly. That you have time to think. That your health, family, friendships, purpose, and day-to-day life feel the way you want them to.</p>
      <div class="emphasis-lines">
        <p>Life 2.0 is about designing the whole thing.</p>
        <p>Not abandoning your ambition.</p>
        <p>Building a life big enough to hold it.</p>
      </div>
      <h3 class="pa-founder-subhead">The Life 2.0 Private Advisory</h3>
      <p class="body-copy">It's six focused weeks, fully individualized and built around exactly what's going on in your life right now.</p>
      <p class="body-copy">We'll work on what's in front of you right now while building toward the direction you want your life to take.</p>
      <p class="pull-statement">The goal is simple: to help you create a life you are wildly excited to wake up to.</p>
    </div>
  </div>

  <section class="section wb-section-tight wrap">
    <h2 class="dz-reveal">What you get</h2>
    <div class="numbered-features">
      {whatYouGet.map((item, i) => (
        <div class="numbered-feature dz-reveal" style={`--dz-delay:${Math.min(i * 0.06, 0.3)}s`}>
          <div class="num">{String(i + 1).padStart(2, '0')}</div>
          <div>
            <h3>{item.title}</h3>
            {item.body.map((p) => <p class="body-copy">{p}</p>)}
            {item.subList && (
              <ul class="sub-list">
                {item.subList.map((s) => <li>{s}</li>)}
              </ul>
            )}
            {item.closing && <p class="body-copy" style="font-weight:600; color:var(--forest);">{item.closing}</p>}
          </div>
        </div>
      ))}
    </div>
    <a class="btn-text dz-reveal" href="/access-your-next-level#included" style="display:inline-block; margin-top:32px;">See the full six-week curriculum &rarr;</a>
  </section>

  <section class="section wb-section-tight wrap dz-reveal">
    <div class="wb-for-split pa-who-split">
      <div class="wb-for-image">
        <img src="/assets/laura-bookshelf.jpg" alt="Laura Kelly" loading="lazy" />
      </div>
      <div class="pa-who-text">
        <h2>Who this is for</h2>
        <p class="body-copy">Life 2.0 Private Advisory is designed for people who are ambitious, capable, and willing to do the work. You may already have a successful business, career, family, or life on paper. But you're asking bigger questions now.</p>
        <ul class="rhetorical-list">
          {rhetoricalQuestions.map((q) => <li>{q}</li>)}
        </ul>
        <p class="pull-statement pa-who-closer">And most importantly: what do I want my Life 2.0 to be?</p>
      </div>
    </div>
  </section>

  <section class="section wb-section-tight wrap pa-pricing-split" id="pricing">
    <div class="dz-reveal pa-pricing-intro pa-pricing-intro-boxed">
      <h2 class="pa-pricing-eyebrow">Founding client opportunity</h2>
      <p class="body-copy">Life 2.0 is entering its founding chapter. Laura is opening a small number of spots for the first cohort of Life 2.0 Private Advisory clients. These founding clients will receive the full private advisory experience while also having a unique opportunity to help shape the future of Life 2.0.</p>
      <a class="btn-primary" href="#apply" style="margin-top:28px; align-self:center;">Apply for Private Advisory &rarr;</a>
    </div>

    <div class="pricing-card dz-reveal" style="--dz-delay:0.1s">
      <div class="eyebrow">Six-Week Private Advisory</div>
      <div class="price">$2,000<span>/month</span></div>
      <p>Delivered privately, at the same depth as the group program. Your founding rate is locked in while you remain continuously active in the Private Advisory.</p>
      <p>This isn't a discounted version of Life 2.0. It's the opportunity to come in at the beginning.</p>
    </div>
  </section>

  <!-- No dz-reveal here: this is an anchor target (#apply), it must be visible the instant it's jumped to. -->
  <section class="section wrap" id="apply">
    <div class="pa-apply-head">
      <h2>Apply for Private Advisory</h2>
      <p class="body-copy">Private Advisory is capacity-limited during the founding chapter. Laura reads every application herself and personally reviews it before booking your Clarity Call, this is the qualifying step, not an instant scheduler.</p>
    </div>
    {applyError && (
      <p class="body-copy" style="color:#B5533C; font-weight:600; margin-top:20px;">
        {applyError === 'missing-fields' ? 'Please fill in your name and email before applying.' : 'Something went wrong submitting your application. Please try again in a moment.'}
      </p>
    )}
    <form class="form-panel" style="margin-top:32px;" action="/api/private-advisory-application" method="post">
      <div class="form-field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required />
      </div>
      <div class="form-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />
      </div>
      <div class="form-field">
        <label for="context">What's going on right now?</label>
        <textarea id="context" name="context" rows="4"></textarea>
      </div>
      <button class="btn-primary" type="submit" style="width:100%; justify-content:center;">Apply for Private Advisory</button>
    </form>
  </section>
</BaseLayout>

<style>
  /* "You know how to achieve." had no font rule of its own anywhere in the
     site (only .section h2, .founder h2, etc. exist) — it was quietly
     rendering as a plain bold system heading instead of the branded serif
     used everywhere else. Style it here, and size both it and the "Life 2.0
     Private Advisory" copy folded in below it down to fit as supporting
     column text beside the photo, not a full page-width section heading. */
  .pa-founder-grid h2 { font: 500 clamp(26px, 2.6vw, 34px)/1.2 var(--serif); color: var(--forest); }
  .pa-founder-subhead { margin-top: 32px; margin-bottom: 12px; font: 500 clamp(21px, 2vw, 26px)/1.3 var(--serif); color: var(--forest); }
  .pa-founder-grid .pull-statement { font-size: 20px; max-width: none; }

  /* The rhetorical questions above it are already italic serif, so the
     closing line in that same style read as just one more item in the list
     instead of the punch line. Make it upright and bolder so it lands. */
  .pa-who-closer { font-style: normal; font-weight: 700; font-size: clamp(24px, 2.6vw, 32px); }

  /* One "Founding client opportunity" heading instead of it and the pricing
     card's own "Founding Client Investment" eyebrow both saying the same
     thing, side by side instead of stacked so the card doesn't sit under a
     full-width intro paragraph with nothing beside it. */
  .pa-pricing-split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; }
  .pa-pricing-split .pricing-card { margin-top: 0; }
  @media (max-width: 860px) { .pa-pricing-split { grid-template-columns: 1fr; gap: 32px; } }

  /* Match the "Founding client opportunity" heading to the eyebrow tag style
     used for "Private Advisory" at the top of the page (mono, uppercase,
     letter-spaced, gold), instead of the default big serif section heading. */
  .pa-pricing-eyebrow { display: flex; align-items: center; gap: 12px; font: 600 clamp(18px, 1.8vw, 22px)/1.3 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
  .pa-pricing-eyebrow::before { content: ""; width: 34px; height: 1px; background: var(--gold); flex-shrink: 0; }

  .pa-pricing-intro .body-copy { margin-top: 16px; }

  /* A bordered box matching the pricing card's shape and weight, instead of
     plain unboxed text that read as thin and small beside it. Bigger body
     text too, to hold its own next to the card's bold price and copy. */
  .pa-pricing-intro-boxed {
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(32px, 5vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pa-pricing-intro-boxed .body-copy { font-size: clamp(20px, 1.7vw, 24px); line-height: 1.7; }


  /* Center the apply heading + intro to match the centered form below it. */
  .pa-apply-head { max-width: 560px; margin: 0 auto; text-align: center; }
  .pa-apply-head .body-copy { margin-top: 16px; }

  /* The heading, paragraph, question list, and closing line had three
     different fixed gaps between them (20px, 18px, 32px), which read as
     lumpy rather than an even rhythm running the length of the photo.
     space-between looked like the fix, but this column's content is
     already about as tall as the photo, so there was no slack left for it
     to distribute — every gap just collapsed to 0. A single consistent
     gap gets the even rhythm without depending on leftover space. */
  .pa-who-text { display: flex; flex-direction: column; gap: 28px; }
  .pa-who-text .body-copy, .pa-who-text .rhetorical-list, .pa-who-text .pull-statement { margin-top: 0; }
</style>
