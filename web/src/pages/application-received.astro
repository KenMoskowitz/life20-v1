---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Application Received | Life 2.0"
  description="Your Life 2.0 Private Advisory application has been received."
  canonicalUrl="https://thelife20.com/application-received"
  noindex={true}
>
  <div class="page-hero wrap" style="text-align:center; max-width: 640px;">
    <div class="eyebrow" style="justify-content:center;">Application Received</div>
    <h1>Got it. Laura will read this herself.</h1>
    <p class="lede">Your application is in. Laura reads every one personally, not a team, not a filter. If it's a fit, you'll hear back within a few days to schedule your Clarity Call.</p>
  </div>

  <section class="section wrap" style="text-align:center;">
    <h2>While you wait, two things worth doing</h2>
    <ul class="list-plain" style="max-width: 480px; margin: 24px auto 0; text-align:left;">
      <li>Take the free 9 Skills assessment if you haven't yet, it'll make your Clarity Call sharper.</li>
      <li>Read a recent essay in the Journal.</li>
    </ul>
    <div style="margin-top: 40px; display:flex; gap:24px; justify-content:center; flex-wrap:wrap;">
      <a class="btn-primary" href="/assessment">Take the assessment</a>
      <a class="btn-text" href="/journal">Read the Journal</a>
    </div>
  </section>
</BaseLayout>
