---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWebinar } from '../lib/sanity';

// Everything variable about this event lives in Sanity so Laura can set the
// date, agenda and copy herself. The page is written to degrade honestly:
// a section with no content is omitted rather than filled with placeholder
// text, and the page stays out of Google until `status` says it's real.
const webinar = (await getWebinar('blueprint')) as Record<string, any> | null;

const EVENT_NAME = webinar?.title ?? 'The High Achiever’s Fulfillment Blueprint';

const status: string = webinar?.status ?? 'draft';
const isLive = status === 'upcoming' || status === 'replay';
const isReplay = status === 'replay';
const isClosed = status === 'closed';

// Only index once there's a real event behind the page.
const noindex = !isLive;

const startsAt: string | null = webinar?.startsAt ?? null;
const durationMinutes: number | null = webinar?.durationMinutes ?? null;
const priceNote: string | null = webinar?.priceNote ?? null;

const learn: Array<{ title: string; body?: string }> = webinar?.whatYouWillLearn ?? [];
const forWhom: string[] = webinar?.whoThisIsFor ?? [];
// Falls back to a real bio rather than hiding the section, since a webinar
// page with no visible host reads as anonymous and hurts, not helps, trust.
const hostNote: string =
  webinar?.hostNote ??
  'Laura Kelly built Life 2.0 after doing everything "right" — the career, the marriage, the house — and finding out that right and good aren’t always the same word. She’s spent the years since building a fast, honest way to find exactly where that gap is, for people who’d rather look at it directly than keep outrunning it. This training is the short version of how she does that.';
const replayNote: string | null = webinar?.replayNote ?? null;

const externalUrl: string | null = webinar?.externalRegistrationUrl ?? null;
const ctaLabel: string = webinar?.ctaLabel ?? (isLive ? 'Save my seat' : 'Tell me when registration opens');

// This page is prerendered (static) so it stays fast for ad traffic, which
// means query params can't be read here at build time. The post-submit
// states are rendered up front and toggled client-side instead.

const title = webinar?.metaTitle ?? `${EVENT_NAME} | Life 2.0`;
const description =
  webinar?.metaDescription ??
  `${EVENT_NAME}, a live training with Laura Kelly for high achievers who have built real success and want a life that feels as good as it looks.`;

const headline = webinar?.heroHeadline ?? EVENT_NAME;
const subhead = webinar?.heroSubhead ?? null;

// Server-rendered fallback in UTC; a small script below rewrites it into the
// visitor's own timezone, since timezone confusion is the main reason people
// miss a webinar they registered for.
function formatUtc(iso: string) {
  const d = new Date(iso);
  return d.toLocaleString('en-US', {
    weekday: 'long', month: 'long', day: 'numeric',
    hour: 'numeric', minute: '2-digit',
    timeZone: 'UTC', timeZoneName: 'short',
  });
}

// Event structured data is emitted only when there is a genuine date, so we
// never publish invented event markup to Google.
const jsonLd =
  isLive && startsAt
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: EVENT_NAME,
        description,
        startDate: startsAt,
        ...(durationMinutes ? { endDate: new Date(new Date(startsAt).getTime() + durationMinutes * 60000).toISOString() } : {}),
        eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
        eventStatus: 'https://schema.org/EventScheduled',
        location: {
          '@type': 'VirtualLocation',
          url: 'https://thelife20.com/blueprint',
        },
        organizer: { '@type': 'Organization', name: 'Life 2.0', url: 'https://thelife20.com' },
        performer: { '@type': 'Person', name: 'Laura Kelly' },
        ...(priceNote && /free/i.test(priceNote)
          ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://thelife20.com/blueprint' } }
          : {}),
      }
    : undefined;
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl="https://thelife20.com/blueprint"
  jsonLd={jsonLd}
  noindex={noindex}
  bare
>
  <!-- HERO: an "event," not an info page — date badge, framed portrait, elevated facts -->
  <section class="wb-hero">
    <div class="wb-hero-grid">
      <div class="wb-hero-copy">
        <div class="wb-eyebrow-pill dz-enter" style="--dz-enter-delay:0s">
          <span class="dot"></span>
          {isReplay ? 'On-demand training' : 'Live training with Laura Kelly'}
        </div>
        <h1 class="dz-enter" style="--dz-enter-delay:0.08s">{headline}</h1>
        {subhead && subhead.split(/\n\s*\n/).map((para: string) => (
          <p class="wb-hero-sub dz-enter" style="--dz-enter-delay:0.16s">{para}</p>
        ))}

        {(startsAt || durationMinutes || priceNote) && (
          <ul class="wb-facts dz-enter" style="--dz-enter-delay:0.24s">
            {startsAt && (
              <li class="wb-fact">
                <span class="wb-fact-label">When</span>
                <time class="wb-fact-value" datetime={startsAt} data-webinar-date>{formatUtc(startsAt)}</time>
              </li>
            )}
            {durationMinutes && (
              <li class="wb-fact">
                <span class="wb-fact-label">Length</span>
                <span class="wb-fact-value">{durationMinutes} minutes</span>
              </li>
            )}
            {priceNote && (
              <li class="wb-fact">
                <span class="wb-fact-label">Cost</span>
                <span class="wb-fact-value">{priceNote}</span>
              </li>
            )}
          </ul>
        )}

        {!isClosed && (
          <div class="wb-hero-actions dz-enter" style="--dz-enter-delay:0.32s">
            {externalUrl
              ? <a class="btn-primary" href={externalUrl} target="_blank" rel="noopener">{ctaLabel} &rarr;</a>
              : <a class="btn-primary" href="#register">{ctaLabel} &rarr;</a>}
            <span class="wb-hero-trust">Live On Zoom &middot; Free To Attend &middot; Seats Are Limited</span>
          </div>
        )}

        {replayNote && <p class="webinar-replay-note">{replayNote}</p>}
      </div>

      <div class="wb-hero-photo-wrap dz-enter" style="--dz-enter-delay:0.2s">
        <div class="wb-hero-photo">
          <img class="dz-kenburns" src="/assets/laura-podcast.jpg" alt="Laura Kelly, founder of Life 2.0" />
        </div>
      </div>
    </div>
  </section>

  {learn.length > 0 && (
    <section class="section wrap wb-section-tight">
      <div class="eyebrow dz-reveal">What you'll walk away with</div>
      <h2 class="dz-reveal">The Session</h2>
      <div class="wb-learn-grid">
        {learn.map((item, i) => (
          <div class="wb-learn-card dz-reveal dz-lift" style={`--dz-delay:${Math.min(i * 0.12, 0.4)}s`}>
            <span class="wb-num">{`0${i + 1}`}</span>
            <h3>{item.title}</h3>
            {item.body && <p>{item.body}</p>}
          </div>
        ))}
      </div>
    </section>
  )}

  {forWhom.length > 0 && (
    <section class="section wrap dz-reveal wb-section-tight">
      <div class="wb-for-split">
        <div class="wb-for-image">
          <img src="/assets/success-team.jpg" alt="This is what success looks like" />
        </div>
        <div>
          <div class="eyebrow">Who this is for</div>
          <h2 style="margin-top:18px;">{forWhom[0]}</h2>
          <div class="wb-for-prose">
            {forWhom.slice(1).map((line) => (
              <p class="body-copy">{line}</p>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA: restates the promise and date once more before the form, the way a real event page closes the loop -->
  {!isClosed && (
    <section class="wb-final-cta wrap dz-reveal">
      <h2>Come Find Your Next Level</h2>
      {startsAt && <time class="wb-final-meta" datetime={startsAt} data-webinar-date>{formatUtc(startsAt)}</time>}
      {externalUrl
        ? <a class="btn-primary" href={externalUrl} target="_blank" rel="noopener">{ctaLabel} &rarr;</a>
        : <a class="btn-primary" href="#register">{ctaLabel} &rarr;</a>}
    </section>
  )}

  <!-- HOST / SPEAKER: bespoke treatment so Laura reads as real, not a stock bio box. Placed last, closing the page. -->
  <section class="wb-host">
    <div class="wb-host-grid">
      <div class="wb-host-photo-wrap dz-reveal">
        <div class="wb-host-photo">
          <img class="dz-kenburns--rev" src="/assets/laura-advisory.jpg" alt="Laura Kelly" />
        </div>
        <div class="wb-host-quote">
          <p>&ldquo;The next level of success isn&rsquo;t always more achievement. Sometimes it&rsquo;s learning how to better experience the life you&rsquo;ve already built.&rdquo;</p>
        </div>
      </div>
      <div class="wb-host-copy dz-reveal" style="--dz-delay:0.1s">
        <div class="wb-host-name">Your host</div>
        <h2>Laura Kelly</h2>
        <p class="body-copy" style="margin-top:22px;">{hostNote}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Show the start time in the visitor's own timezone. The server renders UTC
  // so the page is still correct without JS; this just makes it unambiguous.
  (function () {
    var els = document.querySelectorAll('[data-webinar-date]');
    if (!els.length) return;
    els.forEach(function (el) {
      var iso = el.getAttribute('datetime');
      if (!iso) return;
      try {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return;
        el.textContent = d.toLocaleString(undefined, {
          weekday: 'long', month: 'long', day: 'numeric',
          hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
        });
      } catch (err) {
        /* keep the server-rendered UTC string */
      }
    });
  })();
</script>
