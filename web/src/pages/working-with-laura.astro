---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { testimonials, storyVideos } from '../data/testimonials';

const title = 'Working With Laura | Life 2.0';
const description = "Who Laura Kelly has worked with, what they say, and what actually changed.";

// Client Stories section is left off entirely until that material is ready,
// rather than shown as an empty placeholder block — same rule the rest of
// this site follows (see /blueprint).
//
// Adding another logo later: drop the file in public/assets/ and add one
// line here. No redesign needed — the marquee lays itself out and the
// track duration scales with however many logos are in this list.
// The 90-second highlight reel of client testimonials, shown first so
// visitors get the gist before the full videos further down.
const reelVideoId = '_sNvVzWPEB0';

const logos = [
  'logo-1.png', 'logo-2.png', 'logo-3.png', 'logo-4.png',
  'logo-5.png', 'logo-6.png', 'logo-7.png', 'logo-8.png',
  'logo-9.png', 'logo-10.png', 'logo-11.png', 'logo-12.png',
];

---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/working-with-laura">
  <div class="page-hero wrap">
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">Working With Laura</h1>
    <p class="lede dz-enter" style="--dz-enter-delay:0.16s">I've spent my career in the room with ambitious people and organizations, as a coach, a speaker, and someone building something alongside them. Here's who I've worked with, what they say about it, and what actually changed.</p>
  </div>

  <section class="wrap reel dz-enter" style="--dz-enter-delay:0.24s">
    <div class="reel-video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${reelVideoId}?rel=0`}
        title="Clients on working with Laura Kelly"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <p class="reel-caption">In their words &middot; 90 seconds</p>
  </section>

  <section class="section wrap wb-section-tight">
    <div class="eyebrow eyebrow-center dz-reveal">People and organizations I've worked with</div>
  </section>
  <section class="logo-marquee dz-reveal" aria-label="Brands and organizations Laura has worked with">
    <div class="logo-marquee-track" style={`--logo-count:${logos.length};`}>
      {[...logos, ...logos].map((logo, i) => (
        <div class="logo-marquee-item" aria-hidden={i >= logos.length ? 'true' : undefined}>
          <img src={`/assets/${logo}`} alt="Partner or client logo" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap wb-section-tight">
    <div class="eyebrow dz-reveal">What people say</div>

    <div class="testimonial-feature dz-reveal">
      <div class="testimonial-feature-copy">
        <p class="testimonial-feature-quote" id="tf-quote">&ldquo;{testimonials[0].quote}&rdquo;</p>
        <p class="testimonial-feature-who" id="tf-who">{testimonials[0].name}</p>
        <p class="testimonial-feature-title" id="tf-title" style={testimonials[0].title ? undefined : 'display:none;'}>{testimonials[0].title}</p>
      </div>
      <div class="testimonial-feature-video">
        <iframe
          id="tf-iframe"
          src={`https://www.youtube-nocookie.com/embed/${testimonials[0].videoId}`}
          title="Video testimonial about working with Laura Kelly"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <div class="testimonial-thumbs" role="tablist" aria-label="Choose a testimonial to watch">
      {testimonials.map((t, i) => (
        <button
          type="button"
          class="testimonial-thumb"
          role="tab"
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-video-id={t.videoId}
          data-name={t.name}
          data-title={t.title}
          data-quote={t.quote}
        >
          <img src={`https://img.youtube.com/vi/${t.videoId}/hqdefault.jpg`} alt="" loading="lazy" />
          <span>{t.name}</span>
        </button>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var iframe = document.getElementById('tf-iframe');
      var quoteEl = document.getElementById('tf-quote');
      var whoEl = document.getElementById('tf-who');
      var titleEl = document.getElementById('tf-title');
      var thumbs = document.querySelectorAll('.testimonial-thumb');
      if (!iframe || !quoteEl || !whoEl || !titleEl || !thumbs.length) return;

      thumbs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.getAttribute('aria-pressed') === 'true') return;
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + btn.getAttribute('data-video-id');
          quoteEl.textContent = '“' + btn.getAttribute('data-quote') + '”';
          whoEl.textContent = btn.getAttribute('data-name');
          var title = btn.getAttribute('data-title') || '';
          titleEl.textContent = title;
          titleEl.style.display = title ? '' : 'none';
          thumbs.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        });
      });
    })();
  </script>

  <section class="section wrap wb-section-tight">
    <div class="eyebrow dz-reveal">More client stories</div>
    <h2 class="dz-reveal">In their own words, on their own phones.</h2>
    <div class="story-grid">
      {storyVideos.map((v, i) => (
        <figure class="story dz-reveal" style={`--dz-delay:${Math.min(i * 0.1, 0.4)}s`}>
          <div class="story-video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.videoId}?rel=0`}
              title={v.headline}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <figcaption>
            <span class="story-headline">{v.headline}</span>
            {v.name && <span class="story-name">{v.name}</span>}
            {v.company && <span class="story-company">{v.company}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CtaBand
    heading="Ready to talk?"
    body="A free 30-minute call with Laura. Get clear on what’s keeping you stuck and your next step."
    ctaLabel="Book a free Clarity Call"
    ctaHref="/clarity"
    secondaryLabel="or see Access Your Next Level"
    secondaryHref="/access-your-next-level"
  />
</BaseLayout>

<style>
  .reel { max-width: 960px; padding-top: 8px; }
  .reel-video { position: relative; aspect-ratio: 16 / 9; border-radius: 24px; overflow: hidden; background: var(--forest); box-shadow: 0 24px 60px rgba(20, 32, 26, 0.18); }
  .reel-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .story-grid { margin-top: 28px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  @media (max-width: 1100px) { .story-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .story-grid { grid-template-columns: 1fr; max-width: 340px; margin-left: auto; margin-right: auto; } }
  .story { margin: 0; }
  .story-video { position: relative; aspect-ratio: 9 / 16; border-radius: 20px; overflow: hidden; background: var(--forest); }
  .story-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .story figcaption { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }
  .story-headline { font: 500 19px/1.35 var(--serif); color: var(--forest); }
  .story-name { font: 600 13px/1.2 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--gold); }
  .story-company { margin-top: -2px; font: 400 15px/1.4 var(--sans); color: var(--ink-soft); }
  .reel-caption { margin-top: 14px; text-align: center; font: 600 14px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold); }
</style>
