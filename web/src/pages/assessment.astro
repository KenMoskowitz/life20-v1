---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/sanity';

const cms = await getPage('assessment') as Record<string, any> | null;

const title = cms?.metaTitle ?? 'The Life 2.0 Fulfillment Assessment';
const description = cms?.metaDescription ?? 'Discover which of the 9 Skills of Fulfillment may deserve your attention right now. A reflective starting point, private by design, no email required to begin.';
---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/assessment">
  <div id="assessment-app" style="padding-top: clamp(24px,5vw,48px);"></div>
</BaseLayout>

<script src="../scripts/assessment.ts"></script>
