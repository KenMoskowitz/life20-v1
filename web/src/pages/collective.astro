---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/sanity';

const cms = await getPage('collective') as Record<string, any> | null;

const title = cms?.metaTitle ?? 'The Life 2.0 Collective | A Community for Ambitious People';
const description = cms?.metaDescription ?? "A psychologically safe, low-performance community for people who are done performing and ready to think out loud. Included with Access Your Next Level.";

const whatFor = [
  'Part of your Access Your Next Level experience, not a separate program',
  'Recurring reflection and connection, not one-and-done',
  "A place to be honest about the gap between how your life looks and how it feels",
  "People spread across the country, so it's built to work across time zones",
];
---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/collective" noindex>
  <div class="page-hero wrap">
    <div class="eyebrow dz-enter" style="--dz-enter-delay:0s">The Life 2.0 Collective</div>
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">A room where you don't have to perform.</h1>
    <p class="lede dz-enter" style="--dz-enter-delay:0.16s">The Collective is included with Access Your Next Level and lives in our private Skool community. It's open now, alongside the six-week program, not a separate purchase or waitlist. A standalone option may come later, but for now, joining Access Your Next Level is how you get in.</p>
  </div>

  <div class="founder-grid wrap" style="padding-bottom: 64px;">
    <div class="founder-photo dz-reveal">
      <img class="dz-kenburns--rev" src="/assets/laura-collective.jpg" alt="Life 2.0 Collective" />
    </div>
    <div class="dz-reveal" style="--dz-delay:0.1s">
      <h2>What this actually is</h2>
      <p class="body-copy" style="margin-top:20px;">Not a curriculum. Not another thing to keep up with. A room, held with real facilitation so everyone gets heard, where you can say the true thing, think out loud, and hear from people carrying a version of the same weight you are.</p>
    </div>
  </div>

  <section class="section wrap dz-reveal">
    <h2>What it's for</h2>
    <ul class="list-plain">
      {whatFor.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="footer-cta dz-reveal">
    <h2>How to get in</h2>
    <p>The Collective comes with Access Your Next Level, on Skool, for as long as you're active in the program.</p>
    <a class="btn-primary" href="/access-your-next-level#join">Join Access Your Next Level &rarr;</a>
  </section>
</BaseLayout>
