---
import BaseLayout from '../layouts/BaseLayout.astro';

// Reads ?error / ?joined off the URL after a Stripe Checkout redirect back
// to this page, so this can't be prerendered to static HTML.
export const prerender = false;

const title = 'Access Your Next Level | Life 2.0';
const description = 'A 6-week small-group Life 2.0 coaching experience for high achievers who are doing well, but know another level is available in business and life.';

const joined = Astro.url.searchParams.get('joined') === '1';
const checkoutError = Astro.url.searchParams.get('error');

const tensionSlides = [
  'You know how to work hard.',
  'You know how to solve problems.',
  'You know how to make things happen.',
  'It stops being “How do I do more?” and becomes “What am I building this for?”',
  'Is my business serving my life, or has my life started serving the business?',
  'It’s about becoming more deliberate about where that ambition is actually taking you.',
  'Achievement without direction can become a very expensive way of running in circles.',
];

const nextLevelCards = [
  {
    title: 'Maybe it is business',
    body: "A ceiling you keep hitting, a version of growth that stopped feeling exciting, or a business that runs you instead of the other way around.",
  },
  {
    title: 'Maybe it is personal',
    body: "The relationships, health, or sense of self that got quietly deprioritized while you were busy succeeding at everything else.",
  },
  {
    title: 'Maybe you cannot name it yet',
    body: "Just a feeling that something is off, or that you're capable of more than the life you're currently living. That's a valid place to start.",
  },
];

const curriculum = [
  {
    week: 'Week 1',
    title: 'Pattern Recognition',
    body: 'Get honest about the patterns actually running your decisions, your relationships, and your business, many of which you\'ve never named out loud.',
  },
  {
    week: 'Week 2',
    title: 'Your Rich Life',
    body: 'Define what a rich life actually means for you, specifically, instead of borrowing someone else\'s definition of success.',
  },
  {
    week: 'Week 3',
    title: 'Values & Rules',
    body: 'Separate the values you actually hold from the rules you inherited and never questioned. They are not always the same thing.',
  },
  {
    week: 'Week 4',
    title: 'Your Primary Question',
    body: 'Identify the real question underneath this season of your life, the one that\'s actually driving everything else.',
  },
  {
    week: 'Week 5',
    title: 'Business as a Vehicle',
    body: 'Look directly at whether your business is serving your life or the other way around, and what would need to change either way.',
  },
  {
    week: 'Week 6',
    title: 'Integration',
    body: 'Bring the previous five weeks together into one clear, workable direction for what comes next.',
  },
];

const methodSteps = [
  { stage: 'Watch', body: 'A short, focused Life 2.0 module before each call. No lecture marathon.' },
  { stage: 'Reflect', body: 'A guided pre-call reflection that gets you honest before you get coached.' },
  { stage: 'Coach', body: 'A live group coaching session with Laura, applied to what\'s actually true for you.' },
  { stage: 'Apply', body: 'One clear thing to do differently before the next week starts.' },
];

const includedItems = [
  '6 structured Life 2.0 modules',
  '6 guided pre-call reflections',
  '6 live group coaching sessions with Laura',
  'Maximum 10 participants',
  'Access to The Life 2.0 Room during the program',
  'Access to relevant Life 2.0 frameworks and resources',
  'Access to the broader Life 2.0 environment during the program',
  'Your final digital Life 2.0 Integration Board',
];

const whoFor = [
  'Ambitious and do not want to apologize for it',
  'Already created some degree of success',
  'Know another level is available',
  'Want business success and a great life',
  'Willing to look at your own patterns',
  'Want coaching, not just content',
  'Value being around other capable people',
  'Ready to make decisions and do something with what you discover',
];

const whoNotFor = [
  'Want someone else to tell you exactly how your life should look',
  'Want motivation without self-reflection',
  'Want another course to watch halfway and forget about',
  'Looking for therapy or treatment for a mental-health condition',
  'Want change without changing anything',
];
---
<BaseLayout title={title} description={description} canonicalUrl="https://thelife20.com/access-your-next-level">
  <div class="page-hero ayn-hero-wide wrap">
    <div class="eyebrow dz-enter" style="--dz-enter-delay:0s">Access Your Next Level</div>
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">A 6-week Life 2.0 coaching experience for what comes next.</h1>
    <p class="lede dz-enter" style="--dz-enter-delay:0.16s">For high achievers who are doing well, but know there is another level available in business and life.</p>
  </div>

  <section class="wrap ayn-tension-banner-wrap dz-reveal">
    <div class="ayn-tension-banner">
      <img class="ayn-tension-banner-img dz-kenburns" src="/assets/laura-closeup.jpg" alt="Laura Kelly" loading="lazy" />
      <div class="ayn-tension-banner-scrim" aria-hidden="true"></div>
      <div class="ayn-tension-banner-content">
        <div class="ayn-price-block">
          <div class="ayn-price-block-label">Founding Cohort</div>
          <div class="ayn-price-block-main">$1,500 paid in full</div>
          <div class="ayn-price-block-alt">or 2 payments of $850</div>
          <div class="ayn-price-block-note">Maximum 10 people</div>
          <div class="ayn-price-block-actions">
            <a class="btn-primary" href="#join">Join the founding cohort &rarr;</a>
            <a class="btn-text" href="#included">See what's included</a>
          </div>
        </div>

        <div class="ayn-tension-copy">
          <h2>You've already proven you can achieve.</h2>

          <div class="ayn-carousel-wrap" id="ayn-tension-carousel">
            <div class="ayn-carousel-track">
              {tensionSlides.map((line, i) => (
                <div class={`ayn-carousel-slide${i === 0 ? ' is-active' : ''}`}>
                  <p>{line}</p>
                </div>
              ))}
            </div>
            <div class="ayn-carousel-controls">
              <button class="ayn-carousel-arrow ayn-carousel-arrow--prev" type="button" aria-label="Previous statement">&larr;</button>
              <div class="ayn-carousel-dots" role="tablist" aria-label="Choose a statement">
                {tensionSlides.map((_, i) => (
                  <button type="button" class="ayn-carousel-dot" role="tab" aria-pressed={i === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
              <button class="ayn-carousel-arrow ayn-carousel-arrow--next" type="button" aria-label="Next statement">&rarr;</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* TODO: Add case study 1 here when approved client story is ready. */}

  <section class="section wrap wb-section-tight">
    <div class="ayn-section-head dz-reveal">
      <h2>What would your next level change?</h2>
      <p class="body-copy">You don't need a fully formed answer to start. You just need to be honest about where it's showing up.</p>
    </div>
    <div class="card-grid ayn-next-grid" style="margin-top:40px;">
      {nextLevelCards.map((c, i) => (
        <div class={`card dz-reveal${i === 2 ? ' dz-highlight' : ''}`} style={`--dz-delay:${i * 0.1}s`}>
          <h3>{c.title}</h3>
          <p class="body-copy">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap wb-section-tight">
    <div class="ayn-section-head dz-reveal">
      <h2>How we get you there</h2>
      <p class="body-copy">The six-week curriculum gives us the framework. The coaching makes it yours.</p>
    </div>
    <div class="ayn-week-grid">
      {curriculum.map((w, i) => (
        <div class="ayn-week-card dz-reveal" style={`--dz-delay:${Math.min(i * 0.05, 0.3)}s`}>
          <div class="ayn-week-label">{w.week}</div>
          <h3>{w.title}</h3>
          <p class="body-copy">{w.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap dz-reveal wb-section-tight">
    <div class="ayn-section-head">
      <h2>This is not passive learning.</h2>
    </div>
    <div class="ayn-rhythm">
      {methodSteps.map((s, i) => (
        <>
          <div class="method-item ayn-rhythm-step dz-reveal" style={`--dz-delay:${i * 0.08}s`}>
            <div class="stage-num">{String(i + 1).padStart(2, '0')}</div>
            <h3>{s.stage}</h3>
            <p>{s.body}</p>
          </div>
          {i < methodSteps.length - 1 && <div class="ayn-rhythm-arrow" aria-hidden="true">&rarr;</div>}
        </>
      ))}
    </div>
    <div class="ayn-rhythm-notes">
      <p>No giant workbook.</p>
      <p>No 50-hour content library.</p>
      <p>The goal is movement, not more to consume.</p>
    </div>
  </section>

  <section class="section wrap dz-reveal wb-section-tight">
    <div class="wb-for-split">
      <div class="wb-for-image">
        <img src="/assets/success-team.jpg" alt="A small group of people in conversation" loading="lazy" />
      </div>
      <div>
        <div class="eyebrow">Why Group?</div>
        <h2 style="margin-top:18px;">The right room changes the quality of your thinking.</h2>
        <div class="wb-for-prose">
          <p class="body-copy">Ten capable people looking honestly at their own lives create a kind of clarity you don't get thinking alone, or performing in a room of hundreds.</p>
        </div>
        <ul class="list-plain" style="margin-top:20px;">
          <li>Maximum 10 people</li>
          <li>Enough perspective to create a genuinely powerful room</li>
          <li>Small enough that you never disappear into an audience</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap wb-section-tight" id="included">
    <div class="ayn-section-head dz-reveal">
      <h2>What's Included</h2>
    </div>

    <div class="ayn-checklist-panel dz-reveal" style="--dz-delay:0.05s;">
      <div class="ayn-checklist">
        <div class="ayn-checklist-col">
          {includedItems.filter((_, i) => i % 2 === 0).map((item) => (
            <div class="ayn-checklist-item">
              <span class="ayn-check">&#10003;</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
        <div class="ayn-checklist-col">
          {includedItems.filter((_, i) => i % 2 === 1).map((item) => (
            <div class="ayn-checklist-item">
              <span class="ayn-check">&#10003;</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="ayn-included-sub dz-reveal" style="--dz-delay:0.1s;">
      <div>
        <h3>The Life 2.0 Room</h3>
        <p class="body-copy">Access to The Life 2.0 Room during the program, a space to keep processing what's coming up between live sessions, not just during them.</p>
      </div>
      <div>
        <h3>Life 2.0 Frameworks</h3>
        <p class="body-copy">Access to the relevant Life 2.0 frameworks and resources that support the curriculum, so the work doesn't stop when the call ends.</p>
      </div>
      <div>
        <h3>Life 2.0 Integration Board</h3>
        <p class="body-copy">A final digital Integration Board that captures your patterns, your primary question, and your direction, built to actually use after the six weeks end.</p>
      </div>
    </div>
  </section>

  <div class="ayn-who-grid wrap">
    <div class="ayn-who-card ayn-who-for dz-reveal">
      <h2>Who this is for</h2>
      <ul class="list-plain">
        {whoFor.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="ayn-who-card ayn-who-not dz-reveal" style="--dz-delay:0.1s;">
      <h2>Who this is not for</h2>
      <ul class="list-plain">
        {whoNotFor.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  {/* TODO: Add 2-3 short testimonials here once real client language is approved. */}

  <section class="section wrap wb-section-tight" id="join">
    <div class="dz-reveal ayn-join-head">
      <h2>Founding Cohort</h2>
    </div>

    <div class="ayn-join-grid">
      <div class="ayn-join-card-col">
        <div class="pricing-card ayn-pricing-card dz-reveal" style="--dz-delay:0.1s">
          <div class="eyebrow">6-Week Small-Group Coaching Experience</div>
          <div class="price">$1,500</div>
          <p>paid in full, or 2 payments of $850</p>
          <p>Maximum 10 places available</p>

          {joined && (
            <p class="ayn-checkout-status">You're in. Check your email for next steps.</p>
          )}
          {checkoutError && (
            <p class="ayn-checkout-status ayn-checkout-status--error">
              Something went wrong starting checkout. Please try again in a moment.
            </p>
          )}

          <div class="ayn-plan-actions">
            <a class="btn-primary" href="/api/checkout?plan=full">Pay in full &mdash; $1,500 &rarr;</a>
            <a class="btn-primary ayn-btn-secondary" href="/api/checkout?plan=installment">2 payments of $850 &rarr;</a>
          </div>
        </div>
      </div>

      <div class="dz-reveal ayn-join-note" style="--dz-delay:0.16s;">
        <h3 class="ayn-subhead">Why the founding price?</h3>
        <p class="body-copy">Access Your Next Level is entering its first cohort. Founding members get the full experience at the founding rate, and a real hand in shaping what this becomes as it grows. As future cohorts open, the investment will increase.</p>
      </div>
    </div>
  </section>

  <section class="wrap ayn-final-banner-wrap dz-reveal">
    <div class="ayn-final-banner">
      <img class="ayn-final-banner-img dz-kenburns--rev" src="/assets/laura-hero.jpg" alt="Laura Kelly" loading="lazy" />
      <div class="ayn-final-banner-scrim" aria-hidden="true"></div>
      <div class="ayn-final-banner-content">
        <h2>If nothing changed over the next year, would you be happy with where your current patterns, decisions, and priorities are taking you?</h2>
        <p><strong>Access Your Next Level.</strong> Six weeks to get clearer, move deliberately, and build more of the life you actually want.</p>
        <a class="btn-primary" href="#join">Join the founding cohort &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Wider than the default .page-hero cap (900px) so the headline doesn't
     read as narrow next to the full-width image sections below it. */
  .ayn-hero-wide { max-width: 1100px; }

  /* --- Hero price block --- */
  .ayn-price-block {
    flex: 0 0 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px 32px;
  }
  .ayn-price-block-label { font: 600 15px/1 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--sage); }
  .ayn-price-block-main { margin-top: 4px; font: 500 22px/1.3 var(--serif); color: var(--forest); }
  .ayn-price-block-alt { font: 400 17px/1.4 var(--sans); color: var(--ink-soft); }
  .ayn-price-block-note { margin-top: 4px; font: 600 15px/1 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--gold); }
  .ayn-price-block-actions {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* --- Centered section intros, used throughout the page --- */
  .ayn-section-head { max-width: 720px; margin: 0 auto; text-align: center; }
  .ayn-section-head .body-copy { margin-left: auto; margin-right: auto; }

  /* --- Opening tension: full photo banner with the rotating line overlaid
     directly on it, instead of sharing space with a separate text block.
     Visible-by-default, JS-enhanced: every slide renders in the DOM, and
     only gets hidden once ayn-carousel--active is added at runtime, so a
     JS failure just shows all seven lines stacked instead of losing them. */
  .ayn-tension-banner-wrap { padding: 8px clamp(24px, 5vw, 72px); }
  .ayn-tension-banner {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    min-height: clamp(500px, 50vw, 700px);
    box-shadow: 0 24px 50px -28px rgba(29, 46, 34, 0.35);
  }
  .ayn-tension-banner-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .ayn-tension-banner-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(20, 32, 26, 0) 28%, rgba(20, 32, 26, 0.6) 68%, rgba(20, 32, 26, 0.88) 100%);
  }
  .ayn-tension-banner-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    padding: clamp(32px, 5vw, 64px);
  }
  .ayn-tension-copy { flex: 1 1 auto; min-width: 0; max-width: 640px; }
  .ayn-tension-banner-content h2 {
    font: 500 16px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 18px;
    /* DM Mono only loads weight 500 site-wide; -webkit-text-stroke fakes a
       heavier look without needing another font weight, and the shadow
       keeps it visible against busy, variable-brightness photo backgrounds. */
    -webkit-text-stroke: 0.6px currentColor;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }
  .ayn-carousel-wrap { display: block; }
  .ayn-carousel-track { min-width: 0; }
  .ayn-carousel-slide { text-align: left; }
  .ayn-carousel-slide + .ayn-carousel-slide { margin-top: 14px; }
  .ayn-carousel-wrap.ayn-carousel--active .ayn-carousel-slide { display: none; }
  .ayn-carousel-wrap.ayn-carousel--active .ayn-carousel-slide.is-active { display: block; }
  .ayn-carousel-slide p { font: 500 italic clamp(30px, 4.6vw, 58px)/1.3 var(--serif); color: var(--paper); }
  .ayn-carousel-controls { display: none; align-items: center; gap: 16px; margin-top: 28px; }
  .ayn-carousel-wrap.ayn-carousel--active .ayn-carousel-controls { display: flex; }
  .ayn-carousel-arrow {
    flex: 0 0 auto;
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(251, 247, 239, 0.35);
    background: rgba(251, 247, 239, 0.1);
    color: var(--paper);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .ayn-carousel-arrow:hover { background: rgba(251, 247, 239, 0.22); transform: translateY(-1px); }
  .ayn-carousel-dots { display: flex; gap: 10px; }
  .ayn-carousel-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(251, 247, 239, 0.35); border: none; cursor: pointer; padding: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .ayn-carousel-dot[aria-pressed="true"] { background: var(--gold); transform: scale(1.3); }
  @media (max-width: 860px) {
    .ayn-tension-banner { min-height: 820px; }
    .ayn-tension-banner-content { flex-direction: column; justify-content: center; }
    .ayn-price-block { flex: 0 0 auto; width: 100%; max-width: 360px; }
    .ayn-tension-copy { max-width: none; width: 100%; }
  }

  /* --- Full-width image break --- */
  .ayn-image-break-wrap { padding: 8px clamp(24px, 5vw, 72px); }
  .ayn-image-break { border-radius: 32px; overflow: hidden; aspect-ratio: 16/7; box-shadow: 0 24px 50px -28px rgba(29, 46, 34, 0.3); }
  .ayn-image-break img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  @media (max-width: 860px) { .ayn-image-break { aspect-ratio: 4/3; } }

  /* --- Next-level cards --- */
  .ayn-next-grid .card { display: flex; flex-direction: column; gap: 12px; }
  .ayn-next-grid .card h3 { font: 500 22px/1.3 var(--serif); color: var(--forest); text-transform: none; letter-spacing: 0; }
  .ayn-next-grid .card.dz-highlight { border-color: var(--gold); background: var(--paper-warm); }

  /* --- Curriculum week cards --- */
  .ayn-week-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 40px; }
  @media (max-width: 980px) { .ayn-week-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .ayn-week-grid { grid-template-columns: 1fr; } }
  .ayn-week-card { background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 26px 24px; }
  .ayn-week-label { font: 600 15px/1 var(--mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--gold); }
  .ayn-week-card h3 { margin-top: 10px; font: 500 21px/1.3 var(--serif); color: var(--forest); }
  .ayn-week-card .body-copy { margin-top: 10px; }

  /* --- Watch/Reflect/Coach/Apply rhythm --- */
  .ayn-rhythm { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 40px; flex-wrap: wrap; }
  .ayn-rhythm-step { flex: 1 1 200px; max-width: 240px; }
  .ayn-rhythm-arrow { font: 600 28px/1 var(--serif); color: var(--gold); flex: 0 0 auto; }
  .ayn-rhythm-notes { margin-top: 32px; max-width: 420px; margin-left: auto; margin-right: auto; text-align: center; display: flex; flex-direction: column; gap: 6px; }
  .ayn-rhythm-notes p { font: 500 20px/1.5 var(--sans); color: var(--ink-soft); }
  @media (max-width: 760px) {
    .ayn-rhythm { flex-direction: column; align-items: stretch; }
    .ayn-rhythm-step { max-width: none; }
    .ayn-rhythm-arrow { transform: rotate(90deg); align-self: center; }
  }

  /* --- Included checklist --- */
  .ayn-checklist-panel { margin-top: 40px; background: var(--white); border: 1px solid var(--line); border-radius: 24px; padding: clamp(28px, 4vw, 44px); }
  /* Two independent flex columns, not a grid: a grid ties row heights
     together across both columns, so a two-line item on one side pushes
     an unrelated single-line item on the other side down with it, leaving
     an uneven gap above its checkmark. Independent columns let each side
     flow at its own pace. */
  .ayn-checklist { display: flex; gap: 32px; }
  .ayn-checklist-col { flex: 1 1 0; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  @media (max-width: 760px) { .ayn-checklist { flex-direction: column; gap: 18px; } }
  .ayn-checklist-item { display: flex; align-items: flex-start; gap: 14px; font: 400 20px/1.5 var(--sans); color: var(--ink); }
  .ayn-check {
    flex-shrink: 0; width: 26px; height: 26px; margin-top: 1px;
    border-radius: 50%; background: var(--forest); color: var(--paper);
    display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700;
  }

  .ayn-included-sub { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .ayn-included-sub h3 { font: 600 20px/1.2 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--sage); margin-bottom: 12px; }
  @media (max-width: 900px) { .ayn-included-sub { grid-template-columns: 1fr; } }

  /* --- Who for / not for --- */
  .ayn-who-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; padding-bottom: 40px; align-items: stretch; }
