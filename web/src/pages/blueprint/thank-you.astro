---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { findYourNextLevel as event, formatEventRange } from '../../data/webinars';

// Where people land after signing up for /blueprint. This page is what the
// Meta Pixel counts as a sign-up (the Lead event), and its only job is to
// get them to actually show up.

const fmt = (iso: string) => new Date(iso).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const googleCalUrl =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  `&text=${encodeURIComponent(`${event.title} (free live training with Laura Kelly)`)}` +
  `&dates=${fmt(event.startsAt)}/${fmt(event.endsAt)}` +
  `&details=${encodeURIComponent('Live on Zoom. Your personal joining link is in your confirmation email.')}` +
  `&location=${encodeURIComponent('Zoom')}`;
---
<BaseLayout
  title={`You're in | ${event.title}`}
  description="You're registered for the free live training with Laura Kelly."
  canonicalUrl="https://thelife20.com/blueprint/thank-you"
  noindex
  bare
  pixelEvent={{ name: 'Lead', params: { content_name: event.title } }}
>
  <section class="ty wrap">
    <div class="eyebrow eyebrow-center dz-enter">You’re registered</div>
    <h1 class="dz-enter" style="--dz-enter-delay:0.08s">You’re in. I can’t wait to see you there.</h1>
    <time class="ty-when dz-enter" style="--dz-enter-delay:0.16s" datetime={event.startsAt} data-event-range>{formatEventRange(event)}</time>

    <ol class="ty-steps">
      <li class="dz-enter" style="--dz-enter-delay:0.24s">
        <span class="stage-num">01</span>
        <div>
          <h2>Put it in your calendar</h2>
          <p>Most people who miss a live training simply forgot. Thirty seconds now saves that.</p>
          <div class="ty-cal">
            <a class="btn-primary" href={googleCalUrl} target="_blank" rel="noopener">Google Calendar</a>
            <a class="btn-primary ty-btn-light" href="/blueprint/calendar.ics">Apple / Outlook</a>
          </div>
        </div>
      </li>
      <li class="dz-enter" style="--dz-enter-delay:0.32s">
        <span class="stage-num">02</span>
        <div>
          <h2>Look for your joining link</h2>
          <p>It’s on its way to your inbox now. If you can’t see it in a few minutes, check your spam or promotions folder.</p>
        </div>
      </li>
      <li class="dz-enter" style="--dz-enter-delay:0.4s">
        <span class="stage-num">03</span>
        <div>
          <h2>Take the free assessment</h2>
          <p>About six minutes, and private. You’ll arrive knowing exactly which area of life deserves your attention, and get far more out of our time together.</p>
          <a class="btn-text" href="/assessment">Take the Overflow Assessment &rarr;</a>
        </div>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  .ty { max-width: 820px; padding-top: clamp(32px, 6vw, 72px); padding-bottom: 72px; text-align: center; }
  .ty h1 { margin-top: 18px; font: 500 clamp(34px, 4.4vw, 56px)/1.12 var(--serif); color: var(--forest); }
  .ty-when { display: block; margin-top: 22px; font: 600 17px/1.4 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--gold); }
  .ty-steps { list-style: none; margin: 48px 0 0; padding: 0; display: flex; flex-direction: column; gap: 18px; text-align: left; }
  .ty-steps li { display: flex; gap: 20px; background: var(--white); border: 1px solid var(--line); border-radius: 24px; padding: clamp(24px, 4vw, 32px); }
  .ty-steps h2 { font: 500 24px/1.3 var(--serif); color: var(--forest); }
  .ty-steps p { margin-top: 8px; font: 400 18px/1.6 var(--sans); color: var(--ink-soft); }
  .ty-steps .btn-text { display: inline-block; margin-top: 14px; }
  .ty-cal { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 12px; }
  .ty-btn-light { background: transparent; color: var(--forest); border: 1px solid var(--forest); }
  .ty-btn-light:hover { background: var(--paper-warm); }
</style>

<script is:inline define:vars={{ START: event.startsAt, END: event.endsAt }}>
  (function () {
    var el = document.querySelector('[data-event-range]');
    if (!el) return;
    try {
      var s = new Date(START), e = new Date(END);
      el.textContent = s.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' }) + ', ' +
        s.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }) + ' – ' +
        e.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
    } catch (err) { /* keep Pacific */ }
  })();
</script>
