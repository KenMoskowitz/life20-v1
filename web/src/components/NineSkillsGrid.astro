---
import { skills, skillGroups } from '../data/skills';

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
}
const {
  eyebrow = 'The Framework',
  heading = 'The 9 Skills of Fulfillment',
  intro = 'Nine learnable capacities that shape how you create and experience your life. Grouped three ways, so you can see which part of life each one belongs to.',
} = Astro.props as Props;
---
<section class="skills-band">
  <div class="skills-band-head dz-reveal">
    <div class="eyebrow">{eyebrow}</div>
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="triad-grid">
    {skillGroups.map((group, i) => (
      <div class="triad-card dz-reveal" style={`--dz-delay:${i * 0.12}s`}>
        <svg class="mark" viewBox="0 0 100 100" fill="none"><circle cx="50" cy="30" r="18" stroke="#C79A56" stroke-width="6"/><circle cx="33" cy="62" r="18" stroke="#C79A56" stroke-width="6"/><circle cx="67" cy="62" r="18" stroke="#C79A56" stroke-width="6"/></svg>
        <h3>{group.title}</h3>
        <ul>
          {skills.filter((s) => s.group === group.id).map((s) => <li>{s.name}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
