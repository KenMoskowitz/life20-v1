---
interface Props {
  quote?: string;
  who?: string;
  image?: string;
}
const {
  quote = '"An empty cup isn\'t failure. It\'s information. Fill your cup, then let it spill."',
  who = 'Laura Kelly, Founder',
  image = '/assets/laura-closeup.jpg',
} = Astro.props as Props;
---
<section class="quote-panel">
  <div class="quote-card dz-reveal">
    <img src={image} alt="Laura Kelly" />
    <div class="quote-copy">
      <p>{quote}</p>
      <div class="who">{who}</div>
    </div>
  </div>
</section>
