---
interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
}
const {
  eyebrow = 'The Framework',
  heading = 'Nine variables. Three groups. One honest look at your life.',
  intro = 'A research-grounded self-assessment, not a personality quiz. Score each one honestly and your lowest score becomes your starting point, not your diagnosis.',
} = Astro.props as Props;

const triad = [
  { title: 'Who you are', items: ['Purpose & Meaning', 'Identity & Autonomy', 'Character & Virtue'] },
  { title: 'How you connect', items: ['Relationships', 'Contribution', 'Presence & Aliveness'] },
  { title: 'What fuels you', items: ['Growth & Challenge', 'Physical Vitality', 'Financial Security'] },
];
---
<section class="variables">
  <div class="variables-head">
    <div class="eyebrow">{eyebrow}</div>
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="triad-grid">
    {triad.map((group) => (
      <div class="triad-card">
        <svg class="mark" viewBox="0 0 100 100" fill="none"><circle cx="50" cy="30" r="18" stroke="#C79A56" stroke-width="6"/><circle cx="33" cy="62" r="18" stroke="#C79A56" stroke-width="6"/><circle cx="67" cy="62" r="18" stroke="#C79A56" stroke-width="6"/></svg>
        <h3>{group.title}</h3>
        <ul>
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
