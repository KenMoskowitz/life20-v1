---
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  eyebrow,
  heading,
  body,
  ctaLabel = 'Join the founding cohort',
  ctaHref = '/access-your-next-level',
  secondaryLabel,
  secondaryHref,
} = Astro.props as Props;
---
<section class="footer-cta dz-reveal">
  {eyebrow && <div class="eyebrow" style="justify-content:center;">{eyebrow}</div>}
  <h2>{heading}</h2>
  {body && <p>{body}</p>}
  <a class="btn-primary" href={ctaHref}>{ctaLabel} &rarr;</a>
  {secondaryLabel && secondaryHref && (
    <a class="btn-text" href={secondaryHref} style="display:block; width:fit-content; margin:20px auto 0;">{secondaryLabel}</a>
  )}
</section>
